# Copy to .env and fill in. docker compose reads this file.

# Provider keys (leave blank to skip a provider; the router falls back past it)
GEMINI_API_KEY=
GROQ_API_KEY=

# Protects /admin/* and the dashboard
ADMIN_TOKEN=change-me-admin-token

# Store redacted prompts in request_logs (off by default)
LOG_PROMPTS=false
LOG_LEVEL=info
